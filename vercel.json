{
    "version": 2,
    "name": "gerador-qr-code",
    "builds": [
      {
        "src": "package.json",
        "use": "@vercel/static-build",
        "config": { "distDir": "dist" }
      },
      {
        "src": "api/generate.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/api/generate",
        "dest": "/api/generate.js"
      },
      {
        "src": "/(.*)",
        "dest": "/$1"
      }
    ]
  }
